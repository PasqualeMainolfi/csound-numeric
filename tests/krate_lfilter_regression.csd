        iGotZHL = i(gkZHL, iIdx)
        iGotZHS = i(gkZHS, iIdx)
        assert(abs(iGotZHL - iHL[iIdx]) < 1e-12)
        assert(abs(iGotZHS - iHS[iIdx]) < 1e-12)
        iIdx += 1
    od
    iZfL[] = fillarray(-0.7790310121376417, 0.56419626714764493, -0.15411915349708996, 0.37091875919355122, -0.19533850883930673, 0.084344091422548714)
    iZfS[] = fillarray(-0.30836785512550313, 0.15311120194570985, 0.18682217401223178, -0.065388590880694056, -0.34449770427650955, 0.1134705649754825, 0.32646849931821736, -0.34570166901780491)
    iZfHL[] = fillarray(2.2030140707319961e-07, -1.4520619937931077e-07, 1.6792444517808997e-08)
    iZfHS[] = fillarray(5.0290683854884696e-08, 2.0229962037980373e-08, -0.0012849558929546334, -0.0018380651084883145)
    iIdx = 0
    while iIdx < 6 do
        iGot = i(gkZfL, iIdx)
        assert(abs(iGot - iZfL[iIdx]) < 1e-12)
        iIdx += 1
    od
    iIdx = 0
    while iIdx < 8 do
        iGot = i(gkZfS, iIdx)
        assert(abs(iGot - iZfS[iIdx]) < 1e-12)
        iIdx += 1
    od
    iIdx = 0
    while iIdx < 3 do
        iGot = i(gkZfHL, iIdx)
        assert(abs(iGot - iZfHL[iIdx]) < 1e-12)
        iIdx += 1
    od
    iIdx = 0
    while iIdx < 4 do
        iGot = i(gkZfHS, iIdx)
        assert(abs(iGot - iZfHS[iIdx]) < 1e-12)
        iIdx += 1
    od
    prints("csnum k-rate and audio lfilter / sosfilter hold\n")
endin
</CsInstruments>

<CsScore>
i 1 0 0.002
i 2 0 0.002
i 4 0 0.002
i 5 0 0.002
i 3 0.003 0.001
e
</CsScore>
</CsoundSynthesizer>
