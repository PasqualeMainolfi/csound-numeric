<CsoundSynthesizer>
<CsOptions>
-n -d
</CsOptions>

<CsInstruments>
sr = 48000
ksmps = 16
nchnls = 1
0dbfs = 1

/* The k-rate and audio forms of csnlfilter and csnsosfilter, and of their
   explicit-state forms csnzlfilter and csnzsosfilter, against the values
   scipy.signal 1.18 gives.

   - k-rate: a (2, 48) signal cut into three blocks of 16 along axis 1, one
     block per pass. Each row keeps its own state from pass to pass, so the
     three outputs put together are lfilter / sosfilt of the whole signal in
     one call. The denominator has a[0] = 2, normalised inside.
   - audio: the impulse response of the same two filters, over the first
     three control periods.
   - the z forms run the same two cases with zf fed back as zi on every pass,
     from zeros: y must come out the same, and zf after the last pass must be
     scipy's final state. */

giX[] = fillarray(0.034000000000000002, 1.3600000000000001, 1.2250000000000001, -0.51000000000000001, -0.29799999999999999, -0.52700000000000002, 0.56999999999999995, -0.056000000000000001, 0.747, -1.847, 1.5669999999999999, -0.096000000000000002, 0.68000000000000005, -0.13700000000000001, -0.379, 0.46300000000000002, 0.82499999999999996, -0.20300000000000001, -0.153, 0.68600000000000005, -0.87, -1.514, 0.39500000000000002, -0.67100000000000004, -1.9199999999999999, -0.81399999999999995, -0.46800000000000003, -1.1930000000000001, -1.492, 0.036999999999999998, 0.89700000000000002, -0.23300000000000001, -0.74399999999999999, 0.38500000000000001, 0.71699999999999997, -0.29999999999999999, 0.54500000000000004, 1.0429999999999999, -0.20699999999999999, -0.81399999999999995, 0.34799999999999998, 0.248, 1.099, -1.2849999999999999, -0.66200000000000003, -0.83799999999999997, -1.734, 0.126, 0.52800000000000002, -0.73899999999999999, 1.3859999999999999, 0.82199999999999995, 0.627, 0.40200000000000002, 0.95599999999999996, -1.3320000000000001, 0.61399999999999999, 0.60299999999999998, -1.768, 0.34699999999999998, -0.25, 0.78200000000000003, -0.439, -0.017999999999999999, 0.34300000000000003, -0.876, 0.59899999999999998, -0.105, 0.49199999999999999, -0.52200000000000002, 1.0860000000000001, 0.60499999999999998, -0.17799999999999999, 0.63200000000000001, 1.26, 1.7909999999999999, -1.5740000000000001, 0.88300000000000001, 0.46500000000000002, -0.094, -1.0069999999999999, 1.2569999999999999, -1.262, 0.56699999999999995, 1.302, -1.6000000000000001, -0.30299999999999999, -1.3089999999999999, 0.24399999999999999, 1.514, 2.024, -1.778, -0.57499999999999996, 0.70399999999999996, 1.579, 0.42099999999999999)
giXShape[] = fillarray(2, 48)
giB[] = fillarray(0.036197866015028862, 0.10859359804508659, 0.10859359804508659, 0.036197866015028862)
giA[] = fillarray(2, -3.5200837606863375, 2.3657865240756619, -0.55611983526909292)
giSos[] = fillarray(0.02635923804931721, 0.019056724017823826, 0.02635923804931721, 1, -1.3754078489160222, 0.55744916452691318, 1, -0.76915168337890005, 0.99999999999999989, 1, -1.3168845692381517, 0.86139848420786747)
giSosShape[] = fillarray(2, 6)

gkL[] init 96
gkS[] init 96
gkHL[] init 48
gkHS[] init 48
gkZL[] init 96
gkZS[] init 96
gkZHL[] init 48
gkZHS[] init 48
gkZfL[] init 6
gkZfS[] init 8
gkZfHL[] init 3
gkZfHS[] init 4

instr 1
    iXFlat:CsnArr = csnfromarray(giX)
    X:CsnArr = csnreshape(iXFlat, giXShape)
    B:CsnArr = csnfromarray(giB)
    A:CsnArr = csnfromarray(giA)
    iSosFlat:CsnArr = csnfromarray(giSos)
    Sos:CsnArr = csnreshape(iSosFlat, giSosShape)

    kpass init 0
    kstart init 0
    kstop init 16
    ktrig init 1
    kstart = min(kpass, 2) * 16
    kstop = kstart + 16
    ktrig = kpass < 3 ? 1 : 0
    Blk:CsnArr = csngetslice(X, 1, kstart, kstop, 1)
    Yl:CsnArr = csnlfilter(B, A, Blk, ktrig, 1)
    Ys:CsnArr = csnsosfilter(Sos, Blk, ktrig, 1)

    if kpass < 3 then
        kYl[][] = csntoarray(Yl)
        kYs[][] = csntoarray(Ys)
        kRow = 0
        while kRow < 2 do
            kCol = 0
            while kCol < 16 do
                gkL[kRow * 48 + kpass * 16 + kCol] = kYl[kRow][kCol]
                gkS[kRow * 48 + kpass * 16 + kCol] = kYs[kRow][kCol]
                kCol += 1
            od
            kRow += 1
        od
    endif
    kpass += 1
endin

instr 2
    B:CsnArr = csnfromarray(giB)
    A:CsnArr = csnfromarray(giA)
    iSosFlat:CsnArr = csnfromarray(giSos)
    Sos:CsnArr = csnreshape(iSosFlat, giSosShape)
    ain = mpulse(1, 0)
    al = csnlfilter(B, A, ain)
    as = csnsosfilter(Sos, ain)
    kpass init 0
    if kpass < 3 then
        kn = 0
        while kn < ksmps do
            gkHL[kpass * 16 + kn] = vaget(kn, al)
            gkHS[kpass * 16 + kn] = vaget(kn, as)
            kn += 1
        od
    endif
    kpass += 1
endin

instr 4
    iXFlat:CsnArr = csnfromarray(giX)
    X:CsnArr = csnreshape(iXFlat, giXShape)
    B:CsnArr = csnfromarray(giB)
    A:CsnArr = csnfromarray(giA)
    iSosFlat:CsnArr = csnfromarray(giSos)
    Sos:CsnArr = csnreshape(iSosFlat, giSosShape)
    iZlShape[] = fillarray(2, 3)
    Zl:CsnArr = csnzeros(iZlShape)
    iZsShape[] = fillarray(2, 2, 2)
    Zs:CsnArr = csnzeros(iZsShape)

    kpass init 0
    kstart init 0
    kstop init 16
    ktrig init 1
    kstart = min(kpass, 2) * 16
    kstop = kstart + 16
    ktrig = kpass < 3 ? 1 : 0
    Blk:CsnArr = csngetslice(X, 1, kstart, kstop, 1)
    Yl:CsnArr, Zl csnzlfilter B, A, Blk, Zl, ktrig, 1
    Ys:CsnArr, Zs csnzsosfilter Sos, Blk, Zs, ktrig, 1

    if kpass < 3 then
        kYl[][] = csntoarray(Yl)
        kYs[][] = csntoarray(Ys)
        kRow = 0
        while kRow < 2 do
            kCol = 0
            while kCol < 16 do
                gkZL[kRow * 48 + kpass * 16 + kCol] = kYl[kRow][kCol]
                gkZS[kRow * 48 + kpass * 16 + kCol] = kYs[kRow][kCol]
                kCol += 1
            od
            kRow += 1
        od
    endif
    if kpass == 2 then
        kZl[][] = csntoarray(Zl)
        kZs[][][] = csntoarray(Zs)
        kI = 0
        while kI < 2 * 3 do
            gkZfL[kI] = kZl[int(kI / 3)][kI % 3]
            kI += 1
        od
        kI = 0
        while kI < 8 do
            gkZfS[kI] = kZs[int(kI / 4)][int((kI % 4) / 2)][kI % 2]
            kI += 1
        od
    endif
    kpass += 1
endin

instr 5
    B:CsnArr = csnfromarray(giB)
    A:CsnArr = csnfromarray(giA)
    iSosFlat:CsnArr = csnfromarray(giSos)
    Sos:CsnArr = csnreshape(iSosFlat, giSosShape)
    iZlShape[] = fillarray(3)
    Zl:CsnArr = csnzeros(iZlShape)
    iZsShape[] = fillarray(2, 2)
    Zs:CsnArr = csnzeros(iZsShape)
    ain = mpulse(1, 0)
    al, Zl csnzlfilter B, A, ain, Zl
    as, Zs csnzsosfilter Sos, ain, Zs
    kpass init 0
    if kpass < 3 then
        kn = 0
        while kn < ksmps do
            gkZHL[kpass * 16 + kn] = vaget(kn, al)
            gkZHS[kpass * 16 + kn] = vaget(kn, as)
            kn += 1
        od
    endif
    if kpass == 2 then
        kZl[] = csntoarray(Zl)
        kZs[][] = csntoarray(Zs)
        kI = 0
        while kI < 3 do
            gkZfHL[kI] = kZl[kI]
            kI += 1
        od
        kI = 0
        while kI < 4 do
            gkZfHS[kI] = kZs[int(kI / 2)][kI % 2]
            kI += 1
        od
    endif
    kpass += 1
endin

instr 3
    iL[] = fillarray(0.00061536372225549072, 0.027543705979799625, 0.14561109723517793, 0.35561360650920165, 0.51935453364983553, 0.50268264227401849, 0.32557449138317085, 0.11874424843960785, -0.0044588077786927114, -0.043373492879962096, -0.070425845497111894, -0.077306739116853096, -0.0060681336819069431, 0.11877365142740542, 0.21561481841823138, 0.22997718583773716, 0.1997593514555672, 0.19890089778293049, 0.21711063484619339, 0.21040817433128378, 0.1783348977301995, 0.085194709936952287, -0.11237743410296235, -0.33762602566898786, -0.51475385391580031, -0.68612690937561005, -0.86165562843847987, -0.974017983503072, -1.0177733206955584, -1.0323437979053771, -0.96824560290879957, -0.74650970380294657, -0.43235344559863176, -0.17699430581412526, -0.018396507223958483, 0.097706371591219213, 0.18398716121009817, 0.24829040713209644, 0.32357972519306638, 0.36749578424026241, 0.3028258886175223, 0.16369225905805615, 0.069599463835344294, 0.069250330614031408, 0.067478838483823411, -0.044789392709254451, -0.27548160639287694, -0.5624673285762547, 0.0095562366279676198, 0.032112975075042086, 0.05884466967148673, 0.12780365611391895, 0.28212240690953044, 0.47276846586622251, 0.62195998860095059, 0.67486323358875611, 0.58150615502896585, 0.38735729278199754, 0.19153027256878993, -0.0052701732281330849, -0.19889388562934668, -0.30314938267572622, -0.27253000102841163, -0.16260198273931933, -0.052558427425992399, 0.017902449480151003, 0.030042262781945529, 0.006351894537926916, 0.00049339225529938574, 0.02411480596068127, 0.059751794634547467, 0.12725553626405603, 0.23914707306345379, 0.34127242693353799, 0.41155822339392506, 0.51909119316429719, 0.6702973121463166, 0.73072813140348014, 0.64087249947154268, 0.49297493624336586, 0.33065882107332562, 0.14842318409056746, -0.0037944547025546361, -0.09853923354612798, -0.11909531040849997, -0.0444248533197759, 0.023885298893268948, -0.041980147238151175, -0.22656194064227922, -0.37836720955883918, -0.30122202845349255, 0.018745154557254236, 0.31444892043733486, 0.36912550089973839, 0.28633170698344584, 0.27592772550275985)
    iS[] = fillarray(0.00089621409367678518, 0.03822003819430695, 0.13193295791579371, 0.27025406913608402, 0.41298609523279517, 0.47515842356922555, 0.43774405757681134, 0.27111129902523845, 0.063650601516923019, -0.15885280875251992, -0.23616894852568052, -0.20789437230923039, -0.032623136617348086, 0.14810369343684981, 0.27607701820056019, 0.30621155024490254, 0.25735997835561647, 0.1705498743270944, 0.099944038525914672, 0.086729460007855808, 0.10675665552995223, 0.099255780553837519, 0.015095695477307131, -0.17340882809725805, -0.43227984205583958, -0.70743673046246225, -0.92151004726902908, -1.0193107374988759, -1.0229234574441064, -0.95359118842526436, -0.8207007484804888, -0.6382250948522521, -0.43052675027270526, -0.21242065860150755, 0.0022053863990267762, 0.17305621730838844, 0.27986019204025547, 0.32539583922203408, 0.33637933666805531, 0.31840827571464203, 0.27609786194321173, 0.2069396461361187, 0.15222445651024874, 0.070646975091791714, -0.0021712018019386468, -0.10630520990434227, -0.2560748119746552, -0.44366988903718974, 0.013917677690039487, 0.01734812626215354, 0.059280570616326078, 0.12148054232268027, 0.24528100813473347, 0.39334734955814299, 0.55547068727130211, 0.63719702985339788, 0.62852682430355611, 0.48484598067731577, 0.23396470162866634, -0.037719628992898768, -0.28758864491980218, -0.3841310815927742, -0.35904311562888935, -0.22032503493245287, -0.047623207461945066, 0.075907631837893716, 0.12618640468004075, 0.071225080953676481, -0.0013083103705958925, -0.070075910414829148, -0.044455392190921636, 0.061344135008055661, 0.22442335006682879, 0.37923173860081927, 0.48870877876711122, 0.57786675776623331, 0.59596457684559256, 0.60209375297810852, 0.55247310563837537, 0.48838056494436621, 0.34819001285797413, 0.18440911015074302, -0.017108103899542558, -0.14502887080256172, -0.19101569174919897, -0.15470043068849146, -0.060014483656565351, -0.040444479622516197, -0.087401869484041467, -0.19756355718273202, -0.24397007804304302, -0.19348856118538671, -0.0013776030886791524, 0.23702714181602913, 0.4628625819887443, 0.56060987233512605)
    iHL[] = fillarray(0.018098933007514431, 0.086151679105294032, 0.18451825640508338, 0.24598313906280525, 0.23863055318036888, 0.1803351009326675, 0.10352090805127939, 0.035237549821661142, -0.010290657855138524, -0.031009233889899339, -0.032606650283745181, -0.023569875723383014, -0.011536206490707537, -0.0014901618759097933, 0.0044695159149426844, 0.0064214810108975317, 0.0056007609641738733, 0.0035044404658178909, 0.001328416061185003, -0.00024996397963361204, -0.0010368770534104849, -0.0011598870709510021, -0.00088443990488995495, -0.0004729426203687843, -0.00010871891809060374, 0.00012216350283328264, 0.00021210937083580608, 0.00019858461810623882, 0.00013258327261794628, 5.7426819922435098e-05, -5.3982916617366095e-07, -3.2013826423339965e-05, -3.9739018154150533e-05, -3.2223501520287884e-05, -1.8609457330905318e-05, -5.6862895600590665e-06, 3.0448297388183974e-06, 6.910757292769524e-06, 6.9803844713444428e-06, 4.957725879654518e-06, 2.3903600254861153e-06, 2.8363834703932277e-07, -9.4978054858019115e-07, -1.3425041204012272e-06, -1.1605060096935718e-06, -7.185960022790874e-07, -2.653009047802377e-07, 6.0391460447310028e-08)
    iHS[] = fillarray(0.02635923804931721, 0.069749248448104095, 0.14070333576348742, 0.20287983982251226, 0.23926754150400198, 0.22535467853262336, 0.15559873650240019, 0.052702302245893853, -0.043176089458012726, -0.096114734088507459, -0.092893263282602889, -0.047791750031918295, 0.0076860842192914653, 0.042968166714670006, 0.043755896624690073, 0.016709672186765091, -0.017589046710429396, -0.037999596044213192, -0.034438893656373176, -0.011751888469852496, 0.015131295415686729, 0.030860752790088028, 0.028197276541528205, 0.010910050950658298, -0.0097550522258077373, -0.02221599672968971, -0.020907114776822402, -0.0084856864764722845, 0.006740762225581746, 0.016107490688849795, 0.015349100172967029, 0.0063047999708202738, -0.0049334099976526598, -0.011928977923602247, -0.011453210807980027, -0.0047976392851823424, 0.0035571706986846615, 0.0088247021918898948, 0.0085622798375528733, 0.0036769897977478989, -0.0025321400145674358, -0.0065019014508879269, -0.0063817706577507663, -0.0028042813884054871, 0.0018034097513139117, 0.0047897486873815284, 0.0047535918027504995, 0.0021337729888647396)
    iIdx = 0
    while iIdx < 96 do
        iGotL = i(gkL, iIdx)
        iGotS = i(gkS, iIdx)
        assert(abs(iGotL - iL[iIdx]) < 1e-12)
        assert(abs(iGotS - iS[iIdx]) < 1e-12)
        iIdx += 1
    od
    iIdx = 0
    while iIdx < 48 do
        iGotHL = i(gkHL, iIdx)
        iGotHS = i(gkHS, iIdx)
        assert(abs(iGotHL - iHL[iIdx]) < 1e-12)
        assert(abs(iGotHS - iHS[iIdx]) < 1e-12)
        iIdx += 1
    od
    iIdx = 0
    while iIdx < 96 do
        iGotZL = i(gkZL, iIdx)
        iGotZS = i(gkZS, iIdx)
        assert(abs(iGotZL - iL[iIdx]) < 1e-12)
        assert(abs(iGotZS - iS[iIdx]) < 1e-12)
        iIdx += 1
    od
    iIdx = 0
